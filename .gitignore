# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material that must never ship: employer repo listings and the like.
private-media/

# Raw screen recordings: multi-GB, and the cut lives in public/projects/
*.mov

# AI assistant and editor files: local only, never committed
CLAUDE.md
AGENTS.md
.claude/
.impeccable/
.cursor/
.vscode/
.idea/

# local scratch
*.tsbuildinfo
